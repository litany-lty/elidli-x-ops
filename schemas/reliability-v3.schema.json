{
  "$id": "https://x-ops.local/reliability-v3.schema.json",
  "definitions": {
    "DraftRefV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_id",
        "revision"
      ],
      "properties": {
        "draft_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "DraftReviewReceiptV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "receipt_id",
        "draft_ref",
        "text_hashes",
        "fact_mapping",
        "evidence_mapping_hash",
        "evidence_versions",
        "personalization_mode",
        "personal_context_selection",
        "personal_context_selection_hash",
        "validator_version",
        "semantic_review",
        "reviewer",
        "reviewed_at",
        "decision",
        "supersedes_receipt_ref"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "draft_ref": {
          "$ref": "#/definitions/DraftRefV3"
        },
        "text_hashes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "fact_mapping": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FactMapping"
          }
        },
        "evidence_mapping_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "evidence_versions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "hash"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "personalization_mode": {
          "enum": [
            "none",
            "evidence_bound"
          ]
        },
        "personal_context_selection": {
          "oneOf": [
            {
              "$ref": "#/definitions/PersonalContextSelectionV3"
            },
            {
              "type": "null"
            }
          ]
        },
        "personal_context_selection_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "validator_version": {
          "type": "string",
          "minLength": 1
        },
        "semantic_review": {
          "oneOf": [
            {
              "$ref": "#/definitions/DraftSemanticReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_at": {
          "type": "string",
          "format": "instant"
        },
        "decision": {
          "enum": [
            "approved",
            "needs_review",
            "incomplete"
          ]
        },
        "supersedes_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "actual_review_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DraftCheckPayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "draft_input",
        "personalization_mode",
        "personal_context_selection",
        "supersedes_receipt_ref",
        "as_of"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "draft_input": {
          "$ref": "#/definitions/DraftInput"
        },
        "personalization_mode": {
          "enum": [
            "none",
            "evidence_bound"
          ]
        },
        "personal_context_selection": {
          "oneOf": [
            {
              "$ref": "#/definitions/PersonalContextSelectionV3"
            },
            {
              "type": "null"
            }
          ]
        },
        "supersedes_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "as_of": {
          "type": "string",
          "format": "instant"
        },
        "actual_review_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RecordDraftReviewPayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation",
        "data",
        "as_of"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "operation": {
          "const": "draft_review"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "draft",
            "review_receipt"
          ],
          "properties": {
            "draft": {
              "$ref": "#/definitions/DraftRecord"
            },
            "review_receipt": {
              "$ref": "#/definitions/DraftReviewReceiptV3"
            }
          }
        },
        "as_of": {
          "type": "string",
          "format": "instant"
        }
      }
    },
    "MigrationPreviewV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "preview_id",
        "source_hash",
        "source_revision",
        "source_version",
        "target_version",
        "rule_version",
        "counts",
        "limitations",
        "preview_hash"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "preview_id": {
          "type": "string",
          "minLength": 1
        },
        "source_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        },
        "source_version": {
          "enum": [
            1,
            2
          ]
        },
        "target_version": {
          "const": 3
        },
        "rule_version": {
          "type": "string",
          "minLength": 1
        },
        "counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preview_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "StateMigratePayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "operation": {
          "enum": [
            "preview",
            "apply",
            "resume_verify"
          ]
        },
        "preview": {
          "$ref": "#/definitions/MigrationPreviewV3"
        },
        "backup_directory": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RecordAdoptionPayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation",
        "data"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "operation": {
          "const": "adoption"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adoption_id",
            "draft_ref",
            "draft_review_ref",
            "pack_ref",
            "basis",
            "adopted_at"
          ],
          "properties": {
            "adoption_id": {
              "type": "string",
              "minLength": 1
            },
            "draft_ref": {
              "$ref": "#/definitions/DraftRefV3"
            },
            "draft_review_ref": {
              "type": "string",
              "minLength": 1
            },
            "pack_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "basis": {
              "type": "string",
              "minLength": 1
            },
            "adopted_at": {
              "type": "string",
              "format": "instant"
            }
          }
        }
      }
    },
    "AdoptionRecordV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adoption_id",
        "draft_ref",
        "draft_review_ref",
        "pack_ref",
        "basis",
        "adopted_at"
      ],
      "properties": {
        "adoption_id": {
          "type": "string",
          "minLength": 1
        },
        "draft_ref": {
          "$ref": "#/definitions/DraftRefV3"
        },
        "draft_review_ref": {
          "type": "string",
          "minLength": 1
        },
        "pack_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "adopted_at": {
          "type": "string",
          "format": "instant"
        }
      }
    },
    "PublicationRecordV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "adoption_id",
        "post_id",
        "url",
        "published_at",
        "data_mode",
        "confirmed_by",
        "basis",
        "attribution",
        "actual_texts",
        "differences",
        "draft_ref",
        "pack_ref"
      ],
      "properties": {
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "adoption_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "url"
        },
        "published_at": {
          "type": "string",
          "format": "instant"
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        },
        "confirmed_by": {
          "enum": [
            "user",
            "official_api",
            "browser",
            "fixture"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "enum": [
            "exact",
            "modified",
            "unverified"
          ]
        },
        "actual_texts": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "draft_ref": {
          "oneOf": [
            {
              "$ref": "#/definitions/DraftRefV3"
            },
            {
              "type": "null"
            }
          ]
        },
        "pack_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_receipt_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RecordPublicationPayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation",
        "data"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "operation": {
          "const": "publication"
        },
        "data": {
          "$ref": "#/definitions/PublicationRecordV3"
        }
      }
    },
    "RecordPayloadV3": {
      "oneOf": [
        {
          "$ref": "#/definitions/RecordDraftReviewPayloadV3"
        },
        {
          "$ref": "#/definitions/RecordAdoptionPayloadV3"
        },
        {
          "$ref": "#/definitions/RecordPublicationPayloadV3"
        },
        {
          "$ref": "#/definitions/RecordHostMediaPayloadV3"
        },
        {
          "$ref": "#/definitions/ExperimentTransitionPayloadV3"
        },
        {
          "$ref": "#/definitions/RecordPlanViewPayloadV3"
        },
        {
          "$ref": "#/definitions/RecordSourceEvidencePayloadV3"
        }
      ]
    },
    "PersonalContextSelectionV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_hash",
        "brief_or_use_hash",
        "selection_policy_version",
        "selected",
        "selection_hash",
        "contract_version"
      ],
      "properties": {
        "goal_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "brief_or_use_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "selection_policy_version": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "hash",
              "purpose",
              "limitations"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "hash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "selection_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "contract_version": {
          "const": 3
        }
      }
    },
    "HostMediaReceiptV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "status",
        "operation",
        "tool_name",
        "host_call_ref",
        "actual_result_ref",
        "actual_result_sha256",
        "captured_at",
        "binding_id",
        "data_mode"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "operation": {
          "enum": [
            "compose_text",
            "generate_image",
            "edit_image",
            "render_data",
            "inspect_asset",
            "build_preview",
            "review_asset",
            "review_pack",
            "artifact_persistence",
            "review_draft",
            "publication_read"
          ]
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "host_call_ref": {
          "type": "string",
          "minLength": 1
        },
        "actual_result_ref": {
          "type": "string",
          "minLength": 1
        },
        "actual_result_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "instant"
        },
        "binding_id": {
          "type": "string",
          "minLength": 1
        },
        "data_mode": {
          "enum": [
            "live",
            "fixture"
          ]
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_result_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "RecordHostMediaPayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation",
        "data"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "operation": {
          "const": "host_media_receipt"
        },
        "data": {
          "$ref": "#/definitions/HostMediaReceiptV3"
        }
      }
    },
    "RecordSourceEvidencePayloadV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "operation",
        "data",
        "as_of"
      ],
      "properties": {
        "contract_version": {
          "const": 3
        },
        "operation": {
          "const": "source_evidence"
        },
        "as_of": {
          "type": "string",
          "format": "instant"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_record",
            "source_version",
            "raw_receipt",
            "actual_result_path"
          ],
          "properties": {
            "source_record": {
              "$ref": "#/definitions/SourceRecord"
            },
            "source_version": {
              "$ref": "#/definitions/SourceVersion"
            },
            "raw_receipt": {
              "$ref": "#/definitions/RawReceipt"
            },
            "actual_result_path": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}