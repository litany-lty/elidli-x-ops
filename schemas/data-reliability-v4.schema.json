{
  "$id":"https://x-ops.local/schemas/data-reliability-v4.schema.json",
  "$schema":"http://json-schema.org/draft-07/schema#",
  "definitions":{
    "ImportArtifactV4":{
      "type":"object",
      "additionalProperties":false,
      "required":["artifact_sha256","path","material_kind","source_refs"],
      "properties":{
        "artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "path":{"type":"string","minLength":1},
        "material_kind":{"enum":["canonical_json","analytics_csv","host_observations","archive_posts"]},
        "source_ref":{"type":"string","minLength":1},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "CoverageBindingV4":{
      "type":"object",
      "additionalProperties":false,
      "required":["import_batch_id","source_ref","artifact_sha256","measurement_context"],
      "properties":{
        "import_batch_id":{"type":"string","minLength":1},
        "source_ref":{"type":"string","minLength":1},
        "artifact_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "measurement_context":{"type":"object"},
        "views":{"type":"object","additionalProperties":{"enum":["obtained","partial","failed","not_requested","unavailable"]}},
        "completeness":{"enum":["complete","partial","unknown"]},
        "has_more":{"type":"boolean"},
        "stop_reason":{"type":["string","null"]},
        "successful_items":{"type":"integer","minimum":0},
        "failed_items":{"type":"integer","minimum":0},
        "requested_n":{"type":"integer","minimum":0},
        "covered_n":{"type":"integer","minimum":0}
      }
    },
    "MetadataCorrectionV4":{
      "type":"object",
      "additionalProperties":false,
      "required":["field","value","supersedes_fact_refs"],
      "properties":{
        "field":{"enum":["created_at","post_type","parent_post_key","parent_source_version_ref","quoted_post_key","quoted_source_version_ref","thread_root_key","media_refs","linked_source_refs"]},
        "value":{"$ref":"#/definitions/MetadataValueV3"},
        "supersedes_fact_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
      }
    },
    "CanonicalStateInputV4":{
      "type":"object",
      "additionalProperties":false,
      "required":["contract_version","account","analysis_cutoff","post_entities","post_versions","post_aliases","snapshots","source_series","coverage","post_metadata_facts","collection_receipts","import_batches"],
      "properties":{
        "contract_version":{"const":2},
        "account":{"$ref":"#/definitions/Account"},
        "analysis_cutoff":{"type":"string","format":"instant"},
        "post_entities":{"type":"array"},
        "post_versions":{"type":"array"},
        "post_aliases":{"type":"object"},
        "snapshots":{"type":"array"},
        "source_series":{"type":"array"},
        "coverage":{"type":"array","items":{"$ref":"#/definitions/CoverageBindingV4"}},
        "post_metadata_facts":{"type":"object"},
        "collection_receipts":{"type":"object"},
        "import_batches":{"type":"object"},
        "requested_scope":{}
      }
    }
  }
}
