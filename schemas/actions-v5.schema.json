{
  "$id": "https://x-ops.local/schemas/actions-v5.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "StrategyDefinitionV5": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_version","strategy_id","version","change_dimension","reader_behavior_hypothesis","goal","topic_scope","format_scope","surface_scope","required_materials","primary_metric_definition_id","observation_window","comparison_requirements","cost_boundary","risk_boundary","rule_refs","created_at","strategy_hash"],
      "properties": {
        "contract_version":{"const":5}, "strategy_id":{"type":"string","pattern":"^strategy-[a-f0-9]{24}$"}, "version":{"type":"integer","minimum":1},
        "change_dimension":{"type":"string","minLength":1}, "reader_behavior_hypothesis":{"type":"string","minLength":1}, "goal":{"type":"string","minLength":1},
        "topic_scope":{"type":"array","uniqueItems":true,"items":{"type":"string"}}, "format_scope":{"type":"array","uniqueItems":true,"items":{"type":"string"}}, "surface_scope":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "required_materials":{"type":"array","uniqueItems":true,"items":{"type":"string"}}, "primary_metric_definition_id":{"type":"string","minLength":1},
        "observation_window":{"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"enum":["age_window","period"]},"value":{"type":"string","minLength":1},"tolerance_hours":{"type":"number","minimum":0}}},
        "comparison_requirements":{"type":"array","items":{"type":"string"}}, "cost_boundary":{"type":"string","minLength":1}, "risk_boundary":{"type":"string","minLength":1},
        "rule_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}}, "created_at":{"type":"string","format":"instant"}, "strategy_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "ActionRecommendationV5": {
      "type":"object", "additionalProperties":false,
      "required":["contract_version","action_id","priority","strategy_version_ref","originating_proposal_ref","goal","use","objective","target","change","why_now","account_evidence_refs","content_evidence_refs","rule_version_refs","expected_direction","effort","primary_metric_ref","primary_metric_definition_id","guardrail_metric_refs","observation_window","review_condition_or_due_at","success_interpretation","stop_or_revise_condition","uncertainties","retry_reason","addresses_failure_refs","new_relevant_evidence_refs","status","plan_hash"],
      "properties": {
        "contract_version":{"const":5}, "action_id":{"type":"string","minLength":1}, "priority":{"enum":[1,2,3]}, "strategy_version_ref":{"type":"string","minLength":1}, "originating_proposal_ref":{"type":"string","minLength":1}, "goal":{"type":"string","minLength":1}, "use":{"type":"string","minLength":1},
        "objective":{"type":"string","minLength":1}, "target":{"enum":["post_ids","content_series","profile","publishing_habit","data_collection"]}, "change":{"type":"string","minLength":1}, "why_now":{"type":"string","minLength":1},
        "account_evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}}, "content_evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}}, "rule_version_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "expected_direction":{"type":"string"}, "effort":{"type":"object","additionalProperties":false,"required":["level","basis"],"properties":{"level":{"enum":["low","medium","high"]},"basis":{"type":"string"}}},
        "primary_metric_ref":{"type":["string","null"]}, "primary_metric_definition_id":{"type":"string","minLength":1}, "guardrail_metric_refs":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "observation_window":{"type":"object","additionalProperties":false,"required":["description"],"properties":{"description":{"type":"string","minLength":1}}}, "review_condition_or_due_at":{"type":"string","minLength":1}, "success_interpretation":{"type":"string"}, "stop_or_revise_condition":{"type":"string","minLength":1}, "uncertainties":{"type":"array","items":{"type":"string"}}, "retry_reason":{"type":["string","null"]}, "addresses_failure_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}, "new_relevant_evidence_refs":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "status":{"enum":["proposed","accepted","declined","superseded"]}, "decision_ref":{"type":"string"}, "plan_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}
      }
    },
    "ActionExecutionV5":{"type":"object","additionalProperties":false,"required":["contract_version","execution_id","action_id","action_plan_hash","execution_kind","execution_evidence_refs","executed_at","actual_cost","feedback"],"properties":{"contract_version":{"const":5},"execution_id":{"type":"string","minLength":1},"action_id":{"type":"string","minLength":1},"action_plan_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"execution_kind":{"enum":["profile_change","data_collection"]},"execution_evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"executed_at":{"type":"string","format":"instant"},"actual_cost":{"type":"object","additionalProperties":false,"required":["amount","currency","basis"],"properties":{"amount":{"type":"number","minimum":0},"currency":{"type":["string","null"]},"basis":{"type":"string","minLength":1}}},"feedback":{"type":"object","additionalProperties":false,"required":["status","summary"],"properties":{"status":{"enum":["completed","partial","failed"]},"summary":{"type":"string","minLength":1}}}}}
  }
}
